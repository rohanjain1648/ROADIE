# ── Qloo (required for real data) ───────────────────────────────────────────
# Get a hackathon key: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
# Without it ROADIE runs in clearly-labelled MOCK mode.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ── LLM (pick ONE; Groq is preferred if both are set) ───────────────────────
# Groq (free tier: https://console.groq.com/keys) — OpenAI-compatible endpoint
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Force a provider: groq | openai | mock
# LLM_PROVIDER=

# ── Optional: persistence for share links + response cache on serverless ───
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_DAY=25
NEXT_PUBLIC_REPO_URL=https://github.com/<you>/roadie
